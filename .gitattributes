# Keep Linux-sensitive files LF on every platform (CRLF breaks shebangs, YAML heredocs and Docker builds).
*.sh            text eol=lf
*.py            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.ini           text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
